{
  "name": "drawing-automation-v0.1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build",
    "test": "npm run test:frontend && npm run test:server",
    "test:frontend": "node --test tests/frontend/*.test.js",
    "test:server": "python -m unittest discover -s tests/server -v",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "start": "npm run build && python server.py"
  },
  "dependencies": {
    "@mlightcad/cad-simple-viewer": "1.6.3",
    "@mlightcad/data-model": "1.14.3",
    "@mlightcad/libredwg-converter": "3.14.3"
  },
  "devDependencies": {
    "vite": "8.2.2"
  }
}
